   "source": [
    "model = DeepCNN(num_classes=100).to(device)\n",
    "criterion = LabelSmoothingCrossEntropy(smoothing=0.1)\n",
    "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
    "scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=50, gamma=0.5)\n",
    "num_epochs = 200\n",
    "\n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    correct_train = 0\n",
    "    total_train = 0\n",
    "    for images, _, labels_fine in train_loader:\n",
    "        images = images.to(device)\n",
    "        targets = torch.argmax(labels_fine, dim=1).to(device)\n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        running_loss += loss.item() * images.size(0)\n",
    "        _, predicted = torch.max(outputs.data, 1)\n",
    "        total_train += images.size(0)\n",
    "        correct_train += (predicted == targets).sum().item()\n",
    "    epoch_train_loss = running_loss / total_train\n",
    "    epoch_train_acc = 100 * correct_train / total_train\n",
    "\n",
    "    # Validation\n",
    "    model.eval()\n",
    "    val_loss_total = 0.0\n",
    "    correct_val = 0\n",
    "    total_val = 0\n",
    "    with torch.no_grad():\n",
    "        for images, _, labels_fine in val_loader:\n",
    "            images = images.to(device)\n",
    "            targets = torch.argmax(labels_fine, dim=1).to(device)\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, targets)\n",
    "            val_loss_total += loss.item() * images.size(0)\n",
    "            _, predicted = torch.max(outputs.data, 1)\n",
    "            total_val += images.size(0)\n",
    "            correct_val += (predicted == targets).sum().item()\n",
    "    epoch_val_loss = val_loss_total / total_val\n",
    "    epoch_val_acc = 100 * correct_val / total_val\n",
    "\n",
    "    print(f'Epoch [{epoch+1}/{num_epochs}]: '\n",
    "          f'Train Loss: {epoch_train_loss:.4f}, Train Acc: {epoch_train_acc:.2f}%, '\n",
    "          f'Val Loss: {epoch_val_loss:.4f}, Val Acc: {epoch_val_acc:.2f}%')\n",
    "    scheduler.step()\n",
    "\n",
    "# Test\n",
    "model.eval()\n",
    "test_loss_total = 0.0\n",
    "correct_test = 0\n",
    "total_test = 0\n",
    "with torch.no_grad():\n",
    "    for images, _, labels_fine in test_loader:\n",
    "        images = images.to(device)\n",
    "        targets = torch.argmax(labels_fine, dim=1).to(device)\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, targets)\n",
    "        test_loss_total += loss.item() * images.size(0)\n",
    "        _, predicted = torch.max(outputs.data, 1)\n",
    "        total_test += images.size(0)\n",
    "        correct_test += (predicted == targets).sum().item()\n",
    "final_test_loss = test_loss_total / total_test\n",
    "final_test_acc = 100 * correct_test / total_test\n",
    "print(f'Test Loss: {final_test_loss:.4f}')\n",
    "print(f'Test Accuracy on {total_test} test images: {final_test_acc:.2f}%')"
   ]
  },
